{
  "name": "potato-faithful-mockup",
  "private": true,
  "scripts": {
    "build": "node build.cjs",
    "format": "prettier --write src/*.js src/*.css *.cjs",
    "check": "prettier --check src/*.js src/*.css *.cjs && node --check src/fx.js && node --check src/site.js",
    "test:build": "node build-check.cjs",
    "test:browser": "node verify.cjs",
    "test:setup": "zola --root ../.. build --output-dir verification/original",
    "preview": "python3 -m http.server 18766 --bind 127.0.0.1 --directory dist"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "prettier": "3.6.2"
  }
}
